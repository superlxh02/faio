@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(LIBURING QUIET IMPORTED_TARGET liburing)
if(NOT LIBURING_FOUND)
    set(faio_FOUND FALSE)
    set(faio_NOT_FOUND_MESSAGE "faio requires liburing (discoverable with pkg-config)")
    return()
endif()
find_dependency(Threads)
find_dependency(spdlog CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/faioTargets.cmake")
check_required_components(faio)
