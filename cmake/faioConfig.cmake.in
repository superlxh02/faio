#[[
@file cmake/faioConfig.cmake.in
@brief 导入 faio 安装包的依赖与目标。
]]
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@FAIO_ENABLE_IO_URING@)

    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Liburing)
endif()

find_dependency(Threads)
find_dependency(spdlog CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/FaioMinGW.cmake")
faio_enable_mingw_tls_workaround()

include("${CMAKE_CURRENT_LIST_DIR}/FaioAllocator.cmake")
faio_configure_allocator()
include("${CMAKE_CURRENT_LIST_DIR}/faioTargets.cmake")

set(_faio_load_experimental FALSE)
set(_faio_load_protocols FALSE)
foreach(_faio_component IN LISTS faio_FIND_COMPONENTS)
    if(_faio_component STREQUAL "tls")
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/faioProtocolsConfig.cmake")
            set(_faio_load_protocols TRUE)
        else()
            set(faio_${_faio_component}_FOUND FALSE)
            set(faio_NOT_FOUND_MESSAGE "faio was installed without TLS")
        endif()
    elseif(_faio_component STREQUAL "process")
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/faioProcessTargets.cmake")
            include("${CMAKE_CURRENT_LIST_DIR}/faioProcessTargets.cmake")
            set(faio_process_FOUND TRUE)
        else()
            set(faio_process_FOUND FALSE)
            set(faio_NOT_FOUND_MESSAGE "faio was installed without process")
        endif()
    elseif(_faio_component MATCHES "^experimental_(runtime|reflection|execution|lifecycle)$")
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/faioExperimentalConfig.cmake")
            set(_faio_load_experimental TRUE)
        else()
            set(faio_${_faio_component}_FOUND FALSE)
            set(faio_NOT_FOUND_MESSAGE "faio was installed without experimental components")
        endif()
    else()
        set(faio_${_faio_component}_FOUND FALSE)
        set(faio_NOT_FOUND_MESSAGE "Unknown faio component: ${_faio_component}")
    endif()
endforeach()
if(_faio_load_protocols)
    include("${CMAKE_CURRENT_LIST_DIR}/faioProtocolsConfig.cmake")
endif()
if(_faio_load_experimental)
    include("${CMAKE_CURRENT_LIST_DIR}/faioExperimentalConfig.cmake")
endif()
check_required_components(faio)
