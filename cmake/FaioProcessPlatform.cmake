include_guard(GLOBAL)

function(faio_check_process_platform)
    if(NOT WIN32 AND NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin)$")
        message(FATAL_ERROR "faio process currently supports Linux glibc, macOS and Windows")
    endif()
    if(NOT WIN32)
        include(CheckCXXSourceCompiles)
        list(APPEND CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
        if(APPLE)
            check_cxx_source_compiles("#include <spawn.h>\nint main() { posix_spawn_file_actions_t a; posix_spawn_file_actions_init(&a); posix_spawn_file_actions_addchdir_np(&a, \".\"); posix_spawnattr_t attr; posix_spawnattr_init(&attr); posix_spawnattr_setflags(&attr, POSIX_SPAWN_CLOEXEC_DEFAULT); posix_spawnattr_destroy(&attr); posix_spawn_file_actions_destroy(&a); }" FAIO_PROCESS_HAS_SPAWN_EXTENSIONS)
        else()
            check_cxx_source_compiles("#include <spawn.h>\n#include <unistd.h>\nint main() { posix_spawn_file_actions_t a; posix_spawn_file_actions_init(&a); posix_spawn_file_actions_addchdir_np(&a, \".\"); posix_spawn_file_actions_addclosefrom_np(&a, 3); posix_spawn_file_actions_destroy(&a); }" FAIO_PROCESS_HAS_SPAWN_EXTENSIONS)
        endif()
        if(NOT FAIO_PROCESS_HAS_SPAWN_EXTENSIONS)
            message(FATAL_ERROR "faio process requires posix_spawn addchdir_np/addclosefrom_np (Linux glibc 2.34+ or recent macOS)")
        endif()
    endif()
endfunction()
