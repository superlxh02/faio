include_guard(GLOBAL)

function(faio_configure_entry target)
    cmake_parse_arguments(PARSE_ARGV 1 _faio_entry "" "MODE;SOURCE" "")
    if(_faio_entry_UNPARSED_ARGUMENTS OR _faio_entry_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "faio_configure_entry accepts MODE NORMAL or ASYNC and optional SOURCE")
    endif()
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "faio_configure_entry requires an existing executable target")
    endif()
    get_target_property(_faio_entry_type "${target}" TYPE)
    if(NOT _faio_entry_type STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "faio_configure_entry requires an executable target")
    endif()
    if(NOT _faio_entry_MODE)
        if(DEFINED FAIO_EXPERIMENTAL_ENTRY_MODE)
            set(_faio_entry_MODE "${FAIO_EXPERIMENTAL_ENTRY_MODE}")
        else()
            set(_faio_entry_MODE NORMAL)
        endif()
    endif()
    if(NOT _faio_entry_MODE MATCHES "^(NORMAL|ASYNC)$")
        message(FATAL_ERROR "faio_configure_entry MODE must be NORMAL or ASYNC")
    endif()
    get_target_property(_faio_entry_previous "${target}" FAIO_ENTRY_MODE)
    if(_faio_entry_previous AND NOT _faio_entry_previous STREQUAL _faio_entry_MODE)
        message(FATAL_ERROR "faio_configure_entry cannot set conflicting modes on one target")
    endif()
    if(_faio_entry_MODE STREQUAL "NORMAL" AND _faio_entry_SOURCE)
        message(FATAL_ERROR "faio_configure_entry SOURCE is only valid with MODE ASYNC")
    endif()
    if(_faio_entry_previous)
        if(_faio_entry_SOURCE)
            get_target_property(_faio_source_dir "${target}" SOURCE_DIR)
            get_filename_component(_faio_source "${_faio_entry_SOURCE}" ABSOLUTE BASE_DIR "${_faio_source_dir}")
            get_target_property(_faio_previous_source "${target}" FAIO_ENTRY_SOURCE)
            if(NOT _faio_source STREQUAL _faio_previous_source)
                message(FATAL_ERROR "faio_configure_entry cannot set conflicting entry sources on one target")
            endif()
        endif()
        return()
    endif()
    set_property(TARGET "${target}" PROPERTY FAIO_ENTRY_MODE "${_faio_entry_MODE}")
    # faio is a header library. GCC16.1 crashes in stdexec when CMake's automatic
    # module scan adds -fmodules-ts; none of these targets declare C++ modules.
    set_property(TARGET "${target}" PROPERTY CXX_SCAN_FOR_MODULES OFF)
    set_target_properties("${target}" PROPERTIES CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)
    if(_faio_entry_MODE STREQUAL "ASYNC")
        if(NOT TARGET faio::experimental_reflection)
            message(FATAL_ERROR "faio ASYNC entry requires the enabled experimental reflection component")
        endif()
        target_link_libraries("${target}" PRIVATE faio::experimental_reflection)

        # The opt-in async_main.h macro owns main in the original entry TU.
        # SOURCE is retained as an optional compatibility/validation hint only;
        # no source is replaced, copied, or generated by this helper.
        if(_faio_entry_SOURCE)
            get_target_property(_faio_sources "${target}" SOURCES)
            get_target_property(_faio_source_dir "${target}" SOURCE_DIR)
            get_filename_component(_faio_requested_source "${_faio_entry_SOURCE}" ABSOLUTE
                BASE_DIR "${_faio_source_dir}")
            set(_faio_source_found FALSE)
            foreach(_faio_candidate IN LISTS _faio_sources)
                if(_faio_candidate MATCHES "\\$<")
                    continue()
                endif()
                get_filename_component(_faio_absolute "${_faio_candidate}" ABSOLUTE
                    BASE_DIR "${_faio_source_dir}")
                if(_faio_absolute STREQUAL _faio_requested_source)
                    set(_faio_source_found TRUE)
                endif()
            endforeach()
            if(NOT _faio_source_found)
                message(FATAL_ERROR "faio ASYNC SOURCE must belong to the executable target")
            endif()
            set_property(TARGET "${target}" PROPERTY FAIO_ENTRY_SOURCE "${_faio_requested_source}")
        endif()
    endif()
endfunction()
