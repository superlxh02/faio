# Loaded only when a caller explicitly requests an experimental component.
include("${CMAKE_CURRENT_LIST_DIR}/FaioExperimentalToolchain.cmake")
set(_faio_requested_reflection FALSE)
set(_faio_requested_execution FALSE)
foreach(_faio_component IN LISTS faio_FIND_COMPONENTS)
    if(_faio_component STREQUAL "experimental_reflection")
        set(_faio_requested_reflection TRUE)
    elseif(_faio_component STREQUAL "experimental_execution")
        set(_faio_requested_execution TRUE)
    endif()
endforeach()
faio_check_experimental_toolchain(${_faio_requested_reflection})
include("${CMAKE_CURRENT_LIST_DIR}/faioExperimentalTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/FaioExperimentalEntry.cmake")
set(faio_experimental_runtime_FOUND TRUE)
set(faio_experimental_reflection_FOUND @FAIO_EXPERIMENTAL_REFLECTION@)
set(faio_experimental_execution_FOUND @FAIO_EXPERIMENTAL_EXECUTION@)
if(_faio_requested_execution AND faio_experimental_execution_FOUND)
    get_target_property(_faio_stdexec_include faio::experimental_stdexec INTERFACE_INCLUDE_DIRECTORIES)
    faio_check_experimental_execution_contract("${_faio_stdexec_include}")
endif()
