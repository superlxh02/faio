@PACKAGE_INIT@

if(CMAKE_VERSION VERSION_LESS 3.28)
    set(faioModules_FOUND FALSE)
    set(faioModules_NOT_FOUND_MESSAGE "faioModules requires CMake 3.28 or newer")
    return()
endif()

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(spdlog CONFIG)
if(@FAIO_ENABLE_TLS@)
    find_dependency(OpenSSL 3.5 COMPONENTS SSL Crypto)
endif()
if(@FAIO_ENABLE_IO_URING@)
    set(_faio_previous_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Liburing)
    set(CMAKE_MODULE_PATH "${_faio_previous_module_path}")
    unset(_faio_previous_module_path)
endif()
if(@FAIO_MODULE_HAS_ALLOCATOR@)
    include("${CMAKE_CURRENT_LIST_DIR}/FaioAllocator.cmake")
    faio_configure_allocator()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/faioModulesTargets.cmake")

set(faioModules_tls_FOUND @FAIO_ENABLE_TLS@)
set(faioModules_process_FOUND @FAIO_ENABLE_PROCESS@)
if(faioModules_tls_FOUND)
    if(NOT TARGET faio::module_tls)
        add_library(faio::module_tls ALIAS faio::module)
    endif()
endif()
if(faioModules_process_FOUND)
    if(NOT TARGET faio::module_process)
        add_library(faio::module_process ALIAS faio::module)
    endif()
endif()

foreach(_faio_component IN LISTS faioModules_FIND_COMPONENTS)
    if(_faio_component STREQUAL "tls" OR _faio_component STREQUAL "process")
        if(NOT faioModules_${_faio_component}_FOUND)
            set(faioModules_NOT_FOUND_MESSAGE "faioModules was installed without ${_faio_component}")
        endif()
        continue()
    elseif(_faio_component STREQUAL "experimental")
        set(_faio_export faioModulesExperimentalTargets.cmake)
    else()
        set(faioModules_${_faio_component}_FOUND FALSE)
        continue()
    endif()

    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/${_faio_export}")
        include("${CMAKE_CURRENT_LIST_DIR}/${_faio_export}")
        set(faioModules_${_faio_component}_FOUND TRUE)
    else()
        set(faioModules_${_faio_component}_FOUND FALSE)
        set(faioModules_NOT_FOUND_MESSAGE "faioModules was installed without ${_faio_component}")
    endif()
endforeach()
check_required_components(faioModules)
