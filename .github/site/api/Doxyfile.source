PROJECT_NAME = faio-source-model
OUTPUT_DIRECTORY = build/api-source
INPUT = include/faio
RECURSIVE = YES
FILE_PATTERNS = *.hpp *.h
EXCLUDE_PATTERNS = */platform/windows/*
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = NO
PREDEFINED = __linux__=1 __cpp_impl_coroutine=201902L FAIO_ENABLE_IO_URING=1
GENERATE_HTML = NO
GENERATE_LATEX = NO
GENERATE_XML = YES
XML_PROGRAMLISTING = NO
QUIET = YES
WARNINGS = NO
HAVE_DOT = NO

WARN_NO_PARAMDOC = NO
WARN_IF_DOC_ERROR = NO
