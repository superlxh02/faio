PROJECT_NAME = faio
PROJECT_BRIEF = "C++23 公共接口参考"
OUTPUT_DIRECTORY = build/docs-staging
INPUT = build/api-public/public.hpp build/api-public/periodic.dox .github/site/api/index.md
USE_MDFILE_AS_MAINPAGE = .github/site/api/index.md
OUTPUT_LANGUAGE = Chinese
FILE_PATTERNS = *.hpp *.md *.dox
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
HIDE_UNDOC_MEMBERS = YES
HIDE_UNDOC_CLASSES = YES
INTERNAL_DOCS = NO
SOURCE_BROWSER = NO
VERBATIM_HEADERS = NO
SHOW_FILES = NO
SHOW_INCLUDE_FILES = NO
SHOW_USED_FILES = NO
SHOW_HEADERFILE = NO
FULL_PATH_NAMES = NO
INLINE_INHERITED_MEMB = YES
SORT_MEMBER_DOCS = NO
GENERATE_HTML = YES
HTML_OUTPUT = api
HTML_COLORSTYLE = DARK
HTML_EXTRA_STYLESHEET = .github/site/theme/api.css
GENERATE_TREEVIEW = YES
HTML_DYNAMIC_MENUS = YES
SEARCHENGINE = YES
DISABLE_INDEX = NO
GENERATE_LATEX = NO
GENERATE_XML = YES
XML_OUTPUT = ../api-public/xml
XML_PROGRAMLISTING = NO
HAVE_DOT = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = YES
WARN_NO_PARAMDOC = YES
WARN_IF_DOC_ERROR = YES
WARN_LOGFILE = build/api-public/warnings.log
WARN_AS_ERROR = FAIL_ON_WARNINGS
JAVADOC_AUTOBRIEF = YES
REPEAT_BRIEF = YES
MARKDOWN_SUPPORT = YES
