      }
    },
    {
      "name": "windows-clang-all-release",
      "displayName": "windows-clang-all-release",
      "description": "Windows clang release：全特性请求；实验组件当前要求 Linux + GCC 16.1，配置阶段报告平台限制。",
      "inherits": [
        "windows",
        "all",
        "release"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /DNDEBUG"
