{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/target/cmake-build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FAIO_BUILD_EXAMPLES": "ON",
        "FAIO_BUILD_TESTS": "ON",
        "FAIO_BUILD_BENCHMARKS": "ON",
        "FAIO_INSTALL": "ON",
        "FAIO_ENABLE_TLS": "ON",
        "FAIO_ENABLE_PROCESS": "ON",
        "FAIO_SANITIZERS": ""
      }
    },
    {
      "name": "main",
      "hidden": true,
      "cacheVariables": {
        "FAIO_ENABLE_EXPERIMENTAL": "OFF",
        "FAIO_EXPERIMENTAL_REFLECTION": "OFF",
        "FAIO_EXPERIMENTAL_EXECUTION": "OFF"
      }
    },
    {
      "name": "all",
      "hidden": true,
      "cacheVariables": {
        "FAIO_ENABLE_EXPERIMENTAL": "ON",
        "FAIO_EXPERIMENTAL_REFLECTION": "ON",
        "FAIO_EXPERIMENTAL_EXECUTION": "ON",
        "FAIO_EXPERIMENTAL_ENTRY_MODE": "NORMAL"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "modules",
      "hidden": true,
      "description": "打开 C++20 具名模块入口；module 示例的 `import std;` 由 cmake/FaioImportStd.cmake 在 GCC 16.1+ 上自动开启。",
      "cacheVariables": {
        "FAIO_BUILD_MODULES": "ON"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "common",
      "cacheVariables": {
        "FAIO_ENABLE_IO_URING": "ON",
        "FAIO_USE_WORKSPACE_DEPS": "OFF"
      }
    },
    {
      "name": "mac",
      "hidden": true,
      "inherits": "common",
      "cacheVariables": {
        "FAIO_ENABLE_IO_URING": "OFF",
        "FAIO_USE_WORKSPACE_DEPS": "OFF"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "common",
      "cacheVariables": {
        "FAIO_ENABLE_IO_URING": "OFF",
        "FAIO_USE_WORKSPACE_DEPS": "ON",
        "FAIO_DEPENDENCY_ROOT": "${sourceDir}/../faio-deps"
      }
    },
    {
      "name": "linux-all-release",
      "displayName": "linux-all-release",
      "description": "linux release：GCC 16.1，全特性 + 实验组件（要求 Linux 平台）；具名模块构建请用 main 预设或显式 -DFAIO_BUILD_MODULES=ON。",
      "inherits": [
        "linux",
        "all",
        "release"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-all-debug",
      "displayName": "linux-all-debug",
      "description": "linux debug：GCC 16.1，全特性 + 实验组件（要求 Linux 平台）；具名模块构建请用 main 预设或显式 -DFAIO_BUILD_MODULES=ON。",
      "inherits": [
        "linux",
        "all",
        "debug"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-main-release",
      "displayName": "linux-main-release",
      "description": "linux release：Clang 23，稳定特性 + C++20 具名模块入口（module 示例的 `import std;` 需要 GCC 16.1+，跳过该目标）。",
      "inherits": [
        "linux",
        "modules",
        "main",
        "release"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-23",
        "CMAKE_CXX_COMPILER": "clang++-23"
      }
    },
    {
      "name": "linux-main-debug",
      "displayName": "linux-main-debug",
      "description": "linux debug：Clang 23，稳定特性 + C++20 具名模块入口（module 示例的 `import std;` 需要 GCC 16.1+，跳过该目标）。",
      "inherits": [
        "linux",
        "modules",
        "main",
        "debug"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-23",
        "CMAKE_CXX_COMPILER": "clang++-23"
      }
    },
