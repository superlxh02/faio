cmake_minimum_required(VERSION 3.20)

file(GLOB top_level_files LIST_DIRECTORIES FALSE RELATIVE "${FAIO_HEADERS}" "${FAIO_HEADERS}/*")
if (NOT top_level_files STREQUAL "faio.hpp")
    message(FATAL_ERROR "include/faio must contain exactly one top-level file (faio.hpp): ${top_level_files}")
endif ()

file(GLOB_RECURSE headers LIST_DIRECTORIES FALSE RELATIVE "${FAIO_HEADERS}"
        "${FAIO_HEADERS}/*.hpp" "${FAIO_HEADERS}/*.h")
set(include_pattern [=[^[ 	]*#[ 	]*include[ 	]*[<"]([^>"]+)[>"]]=])
set(umbrella_includes)
set(stable_headers)

foreach (header IN LISTS headers)
    if (NOT header STREQUAL "faio.hpp" AND NOT header MATCHES "^(detail|experimental)/")
        list(APPEND stable_headers "${header}")
    endif ()

    file(STRINGS "${FAIO_HEADERS}/${header}" includes REGEX "${include_pattern}")
    foreach (line IN LISTS includes)
        string(REGEX MATCH "${include_pattern}" include_directive "${line}")
        set(dependency "${CMAKE_MATCH_1}")
        if (header STREQUAL "faio.hpp")
            if (NOT dependency MATCHES "^faio/[^/]+/[^/]+\\.hpp$"
                    OR dependency MATCHES "^faio/(detail|experimental)/")
                message(FATAL_ERROR "faio.hpp must include only stable module headers: ${dependency}")
            endif ()
            string(REGEX REPLACE "^faio/" "" module_header "${dependency}")
            list(APPEND umbrella_includes "${module_header}")
        elseif (header MATCHES "^detail/")
            if (dependency MATCHES "^faio/" AND NOT dependency MATCHES "^faio/detail/")
                message(FATAL_ERROR "${header} must not include a public header: ${dependency}")
            endif ()
        elseif (NOT dependency MATCHES "^faio/detail/")
            message(FATAL_ERROR "${header} must include only detail headers: ${dependency}")
        endif ()
    endforeach ()
endforeach ()

list(SORT stable_headers)
list(SORT umbrella_includes)
if (NOT umbrella_includes STREQUAL stable_headers)
    message(FATAL_ERROR "faio.hpp must include every stable module header exactly once")
endif ()
