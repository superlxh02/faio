cc_test(
    name = "experimental_headers",
    size = "small",
    srcs = ["modules/experimental_contract.cpp"],
    cxxopts = ["-DFAIO_USE_HEADERS=1"],
    features = ["-cpp_modules"],
    deps = ["//:faio_experimental_runtime"] + select({
        "//:execution_enabled": ["//:faio_experimental_execution"],
        "//conditions:default": [],
    }),
)

# Reuse the exact importing programs as normal header-mode tests as well.
HEADER_CONTRACTS = {
    "foundation_headers": (
        [
            "modules/foundation_main.cpp",
            "modules/foundation_peer.cpp",
        ],
        "//:faio",
    ),
    "core_headers": (
        ["modules/core_contract.cpp"],
        "//:faio",
    ),
    "tls_headers": (
        ["modules/tls_contract.cpp"],
        "//:faio_tls",
    ),
    "process_headers": (
        ["modules/process_contract.cpp"],
        "//:faio_process",
    ),
}

[
    cc_test(
        name = name,
        size = "small",
        srcs = spec[0],
        args = TLS_ARGS if name == "tls_headers" else [],
        cxxopts = ["-DFAIO_USE_HEADERS=1"],
        data = TLS_FIXTURES if name == "tls_headers" else [],
        features = ["-cpp_modules"],
        deps = [spec[1]],
    )
    for name, spec in HEADER_CONTRACTS.items()
]
