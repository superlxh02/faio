load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_test(
    name = "header_contract",
    size = "small",
    srcs = ["//examples:quickstart.cpp"],
    features = ["-cpp_modules"],
    deps = ["//:faio"],
)

cc_test(
    name = "module_contract",
    size = "small",
    srcs = [
        "modules/foundation_main.cpp",
        "modules/foundation_peer.cpp",
    ],
    deps = ["//:faio_module"],
)

exports_files(
    ["modules/quickstart.cpp"],
    visibility = ["//examples:__pkg__"],
)

cc_test(
    name = "quickstart_module",
    size = "small",
    srcs = ["modules/quickstart.cpp"],
    deps = ["//:faio_module"],
)

IMPORT_COMPONENTS = [
    "faio",
    "common",
    "coroutine",
    "io",
    "net",
    "fs",
    "runtime",
    "stdio",
    "sync",
    "time",
    "log",
    "tls",
    "process",
]

[
    cc_test(
        name = "import_only_" + component,
        size = "small",
        srcs = ["modules/import_only.cpp"],
        cxxopts = [
            "-DFAIO_IMPORT_MODULE=" + ("faio" if component == "faio" else "faio." + component),
            "-DFAIO_IMPORT_" + component.upper() + "=1",
        ] + (["-DFAIO_IMPORT_HAS_TASK=1"] if component not in ["common", "log"] else []) +
                  (["-DFAIO_IMPORT_HAS_RUNTIME=1"] if component in ["faio", "runtime", "stdio", "tls", "process"] else []),
        target_compatible_with = select({
            "//:" + component + "_enabled": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }) if component in ["tls", "process"] else [],
        deps = ["//:faio_module"],
    )
    for component in IMPORT_COMPONENTS
]

cc_test(
    name = "unit",
    size = "medium",
    srcs = ["test_helpers.hpp"] + glob(
        ["test_*.cpp"],
        exclude = [
            "test_match_stdio_compile.cpp",
            "test_process.cpp",
            "test_socket_addr_literal_compile.cpp",
            "test_tls.cpp",
        ],
    ),
    features = ["-cpp_modules"],
    deps = [
        "//:faio",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "process_child",
    testonly = True,
    srcs = ["process_child.cpp"],
    linkopts = select({
        "@platforms//os:windows": ["shell32.lib"],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "tls",
    size = "small",
    srcs = [
        "bazel_runfiles.hpp",
        "test_tls.cpp",
    ],
    data = glob([
        "fixtures/*.pem",
        "fixtures/*.key",
    ]),
    features = ["-cpp_modules"],
    local_defines = ["FAIO_BAZEL_RUNFILES"],
    deps = [
        "//:faio_tls",
        "@googletest//:gtest_main",
        "@rules_cc//cc/runfiles",
    ],
)

cc_test(
    name = "process",
    size = "small",
    srcs = [
        "bazel_runfiles.hpp",
        "test_helpers.hpp",
        "test_process.cpp",
    ],
    data = [":process_child"],
    features = ["-cpp_modules"],
    local_defines = ["FAIO_BAZEL_RUNFILES"],
    deps = [
        "//:faio_process",
        "@googletest//:gtest_main",
        "@rules_cc//cc/runfiles",
    ],
)

TLS_FIXTURES = [
    "fixtures/server.pem",
    "fixtures/server.key",
    "fixtures/ca.pem",
]

TLS_ARGS = ["$(rootpath %s)" % path for path in TLS_FIXTURES]

exports_files(
    TLS_FIXTURES,
    visibility = ["//examples:__pkg__"],
)

cc_test(
    name = "core_module",
    size = "small",
    srcs = ["modules/core_contract.cpp"],
    deps = ["//:faio_module"],
)

cc_test(
    name = "match_stdio_module",
    size = "small",
    srcs = ["modules/match_stdio_contract.cpp"],
    deps = ["//:faio_module"],
)

cc_test(
    name = "tls_module",
    size = "small",
    srcs = ["modules/tls_contract.cpp"],
    args = TLS_ARGS,
    data = TLS_FIXTURES,
    deps = ["//:faio_module_tls"],
)

cc_test(
    name = "process_module",
    size = "small",
    srcs = ["modules/process_contract.cpp"],
    deps = ["//:faio_module_process"],
)

cc_test(
    name = "both_modules",
    size = "small",
    srcs = ["modules/both_contract.cpp"],
    deps = [
        "//:faio_module_process",
        "//:faio_module_tls",
    ],
)

cc_test(
    name = "both_headers",
    size = "small",
