)

[
    cc_test(
        name = "experimental_" + component,
        size = "small",
        srcs = ["experimental/test_" + component + ".cpp"],
        features = ["-cpp_modules"],
        deps = [
            "//:faio_experimental_" + component,
            "@googletest//:gtest_main",
        ],
    )
    for component in [
        "runtime",
        "reflection",
        "lifecycle",
        "execution",
    ]
]

cc_test(
    name = "experimental_entry",
    size = "small",
    srcs = ["experimental/test_entry.cpp"],
    features = ["-cpp_modules"],
    deps = ["//:faio_experimental_reflection"],
)

cc_test(
    name = "experimental_module",
    size = "small",
    srcs = ["modules/experimental_contract.cpp"],
    deps = ["//:faio_module_experimental"],
)

cc_test(
    name = "import_only_experimental",
    size = "small",
    srcs = ["modules/import_only.cpp"],
    cxxopts = [
        "-DFAIO_IMPORT_MODULE=faio.experimental",
        "-DFAIO_IMPORT_HAS_TASK=1",
