{
  "name": "faio-gcc16-cxx26",
  "build": {
    "dockerfile": "../docker/dev-image.dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/faio,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/faio",
  "mounts": [
    "source=faio-target-${devcontainerId},target=/workspace/faio/target,type=volume"
  ],
  "containerEnv": {
    "CC": "/opt/gcc-16.1/usr/bin/gcc",
    "CXX": "/opt/gcc-16.1/usr/bin/g++",
    "CCACHE_DIR": "/workspace/faio/target/ccache",
    "XMAKE_CONFIGDIR": "/workspace/faio/target/xmake"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined"
  ],
  "init": true,
  "remoteUser": "root",
  "postCreateCommand": "bazel --version && xmake --version && cmake --preset linux-all-debug -DCMAKE_CXX_COMPILER=\"$CXX\" && ln -sfn cmake-build-linux-all-debug/compile_commands.json target/compile_commands.json",
  "waitFor": "postCreateCommand",
  "customizations": {
    "jetbrains": {
      "backend": "CLion"
    },
    "vscode": {
      "extensions": [
        "clice-io.clice",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "clice.executable": "/root/.local/bin/clice",
        "clangd.enable": false,
        "clangd.path": "/usr/local/bin/clangd",
        "clangd.arguments": [
          "--background-index",
          "--enable-config",
          "--query-driver=/opt/gcc-16.1/usr/bin/g++,/usr/bin/g++,/usr/lib64/ccache/g++,/usr/local/bin/g++-16,/usr/local/bin/clang++-23,/usr/local/bin/faio-cxx"
        ],
        "C_Cpp.intelliSenseEngine": "disabled",
        "cmake.useCMakePresets": "always",
        "cmake.configureOnOpen": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
